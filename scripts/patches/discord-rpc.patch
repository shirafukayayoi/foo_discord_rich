diff --git a/submodules/discord-rpc/include/discord_rpc.h b/submodules/discord-rpc/include/discord_rpc.h
index 9470434..20f29bc 100644
--- a/submodules/discord-rpc/include/discord_rpc.h
+++ b/submodules/discord-rpc/include/discord_rpc.h
@@ -23,7 +23,34 @@
 extern "C" {
 #endif
 
+typedef enum DiscordActivityType {
+    PLAYING = 0,
+    STREAMING = 1,
+    LISTENING = 2,
+    WATCHING = 3,
+    CUSTOM = 4,
+    COMPETING = 5
+} DiscordActivityType;
+
+typedef enum StatusDisplayType {
+    NAME = 0,
+    STATE = 1,
+    DETAILS = 2
+} StatusDisplayType;
+
+typedef struct DiscordButton {
+    const char* label; /* max 32 bytes */
+    const char* url;   /* max 512 bytes */
+} DiscordButton;
+
 typedef struct DiscordRichPresence {
+    DiscordActivityType activityType;
+    StatusDisplayType statusDisplayType;
     const char* state;   /* max 128 bytes */
     const char* details; /* max 128 bytes */
     int64_t startTimestamp;
@@ -39,6 +61,8 @@ typedef struct DiscordRichPresence {
     const char* matchSecret;    /* max 128 bytes */
     const char* joinSecret;     /* max 128 bytes */
     const char* spectateSecret; /* max 128 bytes */
+    DiscordButton buttons[2]; /* max 2 buttons */
+    int buttonCount;
     int8_t instance;
 } DiscordRichPresence;
diff --git a/submodules/discord-rpc/src/serialization.cpp b/submodules/discord-rpc/src/serialization.cpp
index 70efa63..e822dfc 100644
--- a/submodules/discord-rpc/src/serialization.cpp
+++ b/submodules/discord-rpc/src/serialization.cpp
@@ -105,6 +105,14 @@ size_t JsonWriteRichPresenceObj(char* dest,
             if (presence != nullptr) {
                 WriteObject activity(writer, "activity");
 
+                WriteKey(writer, "type");
+                writer.Int(presence->activityType);
+
+                if (presence->statusDisplayType) {
+                    WriteKey(writer, "status_display_type");
+                    writer.Int(presence->statusDisplayType);
+                }
+
                 WriteOptionalString(writer, "state", presence->state);
                 WriteOptionalString(writer, "details", presence->details);
@@ -160,6 +168,22 @@ size_t JsonWriteRichPresenceObj(char* dest,
 
                 writer.Key("instance");
                 writer.Bool(presence->instance != 0);
+
+                if (presence->buttonCount > 0) {
+                    WriteKey(writer, "buttons");
+                    writer.StartArray();
+                    for (int i = 0; i < presence->buttonCount && i < 2; ++i) {
+                        if (presence->buttons[i].label && presence->buttons[i].url) {
+                            writer.StartObject();
+                            WriteKey(writer, "label");
+                            writer.String(presence->buttons[i].label);
+                            WriteKey(writer, "url");
+                            writer.String(presence->buttons[i].url);
+                            writer.EndObject();
+                        }
+                    }
+                    writer.EndArray();
+                }
             }
         }
     }